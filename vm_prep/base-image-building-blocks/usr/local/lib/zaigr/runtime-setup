#!/bin/bash
set -euo pipefail

log() {
    echo ":: zaigr-runtime-setup: $*"
}

fatal() {
    echo ":: zaigr-runtime-setup: FATAL - $*" >&2
    exit 1
}

cmdline_value() {
    local key="$1"
    sed -n "s/.*${key}=\\([^ ]*\\).*/\\1/p" /proc/cmdline
}

ensure_node() {
    local path="$1"
    local major="$2"
    local minor="$3"

    if [ ! -e "$path" ]; then
        mknod -m 0666 "$path" c "$major" "$minor"
    else
        chmod 0666 "$path"
    fi
}

ensure_mount() {
    local target="$1"
    shift

    if ! mountpoint -q "$target"; then
        mount "$@" "$target"
    fi
}

write_proc() {
    local path="$1"
    local value="$2"

    [ -e "$path" ] || fatal "missing $path"
    printf '%s\n' "$value" > "$path"
}

log "preparing devices and runtime directories"
mkdir -p /dev/shm
ensure_mount /dev/shm -t tmpfs -o mode=1777,nosuid,nodev shm
chmod 1777 /dev/shm

mkdir -p /dev/mqueue
ensure_mount /dev/mqueue -t mqueue mqueue

mkdir -p /dev/pts
ensure_mount /dev/pts -t devpts devpts

ensure_node /dev/fuse 10 229
mkdir -p /dev/net
ensure_node /dev/net/tun 10 200
ln -sfn /proc/self/fd /dev/fd

mkdir -p /run/user/1000
chown user:user /run/user/1000
chmod 700 /run/user/1000

[ -e /dev/mem ] && chmod 600 /dev/mem
[ -e /dev/kmem ] && chmod 600 /dev/kmem
if [ -e /dev/kvm ]; then
    chgrp kvm /dev/kvm
    chmod 0660 /dev/kvm
fi

vm_hostname="$(cmdline_value 'zaigr\.hostname')"
vm_hostname="${vm_hostname:-zaigr}"
hostname "$vm_hostname" || fatal "failed to set hostname from zaigr.hostname"

host_epoch="$(cmdline_value 'zaigr\.host-epoch')"
case "$host_epoch" in
    ''|*[!0-9]*)
        fatal "missing or invalid zaigr.host-epoch"
        ;;
esac
date -s "@$host_epoch" >/dev/null || fatal "failed to set clock from zaigr.host-epoch"
log "clock set from host epoch"

log "mounting workspace and agent state"
mkdir -p /home/user/workspace
ensure_mount /home/user/workspace -t 9p -o trans=virtio,version=9p2000.L,cache=mmap workspace

mkdir -p /home/user/.zaigr-agent-state
ensure_mount /home/user/.zaigr-agent-state -t 9p -o trans=virtio,version=9p2000.L,cache=mmap zaigr_agent_state
chmod 700 /home/user/.zaigr-agent-state || true

log "configuring QEMU user networking"
ip link set lo up
[ -e /sys/class/net/eth0 ] || fatal "no eth0 found"
ip link set eth0 mtu 1400 up
if ! ip -4 addr show dev eth0 | grep -q '10\.0\.2\.15/24'; then
    ip addr add 10.0.2.15/24 dev eth0
fi
ip route replace default via 10.0.2.2 dev eth0
printf 'nameserver 10.0.2.3\n' > /etc/resolv.conf

log "installing root SSH public key"
root_pubkey="$(cmdline_value 'zaigr\.root-pubkey')"
[ -n "$root_pubkey" ] || fatal "missing zaigr.root-pubkey"
mkdir -p /root/.ssh
printf '%s' "$root_pubkey" | base64 -d > /root/.ssh/authorized_keys || fatal "invalid zaigr.root-pubkey"
chown root:root /root/.ssh /root/.ssh/authorized_keys
chmod 700 /root/.ssh
chmod 600 /root/.ssh/authorized_keys

log "preparing SSH host state"
mkdir -p /run/sshd
ssh-keygen -A >/dev/null

log "applying hardening sysctls"
write_proc /proc/sys/kernel/dmesg_restrict 1
write_proc /proc/sys/kernel/kptr_restrict 2
write_proc /proc/sys/kernel/perf_event_paranoid 3

if [ -d /sys/kernel/tracing ]; then
    log "mounting tracefs"
    ensure_mount /sys/kernel/tracing -t tracefs tracefs
fi

log "runtime setup complete"
