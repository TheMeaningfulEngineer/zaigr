# zaigr minimal kernel config for fast QEMU microvm boot
# Target: boot to shell as fast as possible, with 9p workspace sharing

# 64-bit
CONFIG_64BIT=y

# No modules — everything built-in
CONFIG_MODULES=n

# Binary formats
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

# Processor
CONFIG_SMP=y
CONFIG_PREEMPT_NONE=y
CONFIG_HZ_100=y
CONFIG_PROCESSOR_SELECT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y

# Minimal memory model
CONFIG_FLATMEM=y
CONFIG_SPARSEMEM=n

# TTY / Console — virtio console (hvc0) for microvm
CONFIG_TTY=y
CONFIG_VT=n
CONFIG_PRINTK=y
CONFIG_VIRTIO_CONSOLE=y
# Keep serial for fallback/debugging
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Block layer
CONFIG_BLOCK=y

# No PCI — microvm uses MMIO
CONFIG_PCI=n
CONFIG_ACPI=n

# Virtio via MMIO (microvm)
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y

# 9P filesystem (host directory sharing)
CONFIG_NET=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
# 9P cache support (needed for mmap MAP_SHARED on 9p mounts)
CONFIG_FSCACHE=y
CONFIG_9P_FSCACHE=y

# Crypto (needed by ext4)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_CRC32C=y

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# No initramfs — mount root directly
CONFIG_BLK_DEV_INITRD=n

# Networking
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VXLAN=y

# eBPF (needed by OpenSnitch process monitor and DNS interception)
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_PERF_EVENTS=y
CONFIG_DEBUG_FS=y

# inotify (needed by OpenSnitch and many Go programs)
CONFIG_INOTIFY_USER=y

# Packet socket (needed by OpenSnitch)
CONFIG_PACKET=y
CONFIG_INET_DIAG=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y

# Netfilter (needed by OpenSnitch nfqueue interception)
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NF_CT_NETLINK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y

# nftables (OpenSnitch uses nftables inet family for interception)
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_IPV6=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_CHAIN_FILTER=y
CONFIG_NFT_CHAIN_ROUTE=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_QUEUE=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y

# Hypervisor guest support (needed when this kernel runs inside a VM)
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HIGH_RES_TIMERS=y

# KVM (nested virtualization)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# Namespaces (needed by mmdebstrap --mode=unshare in dev builds)
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_TUN=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_KEYS=y

# No unnecessary subsystems
CONFIG_SOUND=n
CONFIG_USB=n
CONFIG_WLAN=n
CONFIG_BLUETOOTH=n
CONFIG_WIRELESS=n
CONFIG_INPUT=n
CONFIG_HID=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_HWMON=n
CONFIG_THERMAL=n
CONFIG_POWER_SUPPLY=n
CONFIG_PCMCIA=n
# CONFIG_DEBUG_KERNEL enabled for debugfs (needed by eBPF/OpenSnitch)
# CONFIG_FTRACE is enabled above for eBPF/OpenSnitch
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_AUDIT=n
CONFIG_PROFILING=n
CONFIG_SWAP=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
