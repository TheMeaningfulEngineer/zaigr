#!/bin/bash
set -euo pipefail

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive

echo ":: Installing OpenCode ..."
apt-get update -qq
apt-get install -y --no-install-recommends nodejs npm ca-certificates git ripgrep

npm install -g --no-audit --no-fund @opencode/cli@2.0.26
opencode --version
